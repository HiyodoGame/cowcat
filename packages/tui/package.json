{
  "name": "@corescense/cowcat-tui",
  "version": "0.0.0",
  "private": true,
  "description": "CowCat v2 frontend: TUI over the headless protocol. Not published yet, and the only package on the Node 26 floor.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build && npm run lint",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
