{
  "name": "@corescense/cowcat-core",
  "version": "0.0.0",
  "private": true,
  "description": "CowCat v2 kernel: event-sourced session runtime, policy engine and ports. Not published yet.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build && npm run lint",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "openai": "^7.36.0",
    "zod": "^4.6.7"
  }
}
