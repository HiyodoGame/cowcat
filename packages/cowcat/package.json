{
  "name": "@corescense/cowcat-core",
  "version": "1.0.0-beta.3",
  "description": "CowCat's kernel: event-sourced session runtime, policy engine, ports and the composition root.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiyodoGame/cowcat.git",
    "directory": "packages/cowcat"
  },
  "homepage": "https://github.com/HiyodoGame/cowcat#readme",
  "bugs": {
    "url": "https://github.com/HiyodoGame/cowcat/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build && npm run lint",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@corescense/cowcat-protocol": "file:../protocol",
    "openai": "^7.36.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
