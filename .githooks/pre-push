#!/bin/sh
# Client-side guard: refuse direct pushes to main so changes go through a PR.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Deliberate override:     git push --no-verify
#
# Why client-side: GitHub branch protection / rulesets are unavailable on private
# repositories on the free plan (the API answers 403 "Upgrade to GitHub Pro or
# make this repository public"), so this is the enforceable half of the policy —
# see docs/CONTRIBUTING.md §6. Tag pushes are not branch pushes and stay allowed.
set -eu

protected="main"
remote="${1:-origin}"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "refs/heads/$protected")
      # Deleting the branch (all-zero local sha) is blocked too.
      if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        echo "pre-push: refusing to delete '$protected' on '$remote'." >&2
        blocked=1
        continue
      fi
      echo "pre-push: direct push to '$protected' is blocked by policy." >&2
      echo "           open a pull request instead (see docs/CONTRIBUTING.md):" >&2
      echo "             git switch -c <type>/<topic>; git push -u origin HEAD; gh pr create --fill" >&2
      echo "           deliberate override: git push --no-verify" >&2
      blocked=1
      ;;
  esac
done

[ "$blocked" -eq 0 ] || exit 1
exit 0
